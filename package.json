{
  "name": "pepkio-ligo-ratio-calc",
  "version": "0.1.0",
  "description": "Multi-ratio ligation calculator with pipetting volumes, pmol tracking, cloning presets, reaction recipes, and Gibson multi-fragment mode via the Pepkio Tools REST API.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-ligo-ratio-calc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzheng/pepkio-ligo-ratio-calc-js.git"
  },
  "bugs": {
    "url": "https://github.com/suzheng/pepkio-ligo-ratio-calc-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/ligo-ratio-calc",
  "keywords": [
    "ligo-ratio-calc",
    "cloning",
    "ligation",
    "molecular-biology",
    "vector",
    "insert",
    "gibson",
    "golden-gate",
    "sticky-end",
    "blunt-end",
    "ta-cloning",
    "pipetting",
    "bioinformatics",
    "pepkio",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv": "^16.6.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
